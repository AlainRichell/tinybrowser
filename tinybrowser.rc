// Icons and other executable resources. The lowest icon id becomes the .exe icon that Explorer and
// the taskbar show; the app also loads it for its window. Id 2 is the file icon: the document sheet
// with the donut in the corner, which the .to association points at so a snapshot never looks like
// the browser itself.
//
// The version block is what Settings, the taskbar tooltip and Explorer read, and the setup panel
// compares the number an installed copy reports against this one, so the names and the numbers live
// in tinyversion.h instead of being typed here and in the code.
#include <windows.h>  // VS_FFI_FILEFLAGSMASK and the VOS_/VFT_ constants
#include "tinyversion.h"

1 ICON "tinybrowser.ico"
2 ICON "tiny-file.ico"

1 VERSIONINFO
 FILEVERSION TINY_VERSION_MAJOR,TINY_VERSION_MINOR,TINY_VERSION_PATCH,TINY_VERSION_BUILD
 PRODUCTVERSION TINY_VERSION_MAJOR,TINY_VERSION_MINOR,TINY_VERSION_PATCH,TINY_VERSION_BUILD
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", TINY_VENDOR_NAME
      VALUE "FileDescription", TINY_PRODUCT_NAME
      VALUE "FileVersion", TINY_VERSION_STRING
      VALUE "InternalName", "tiny"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "tiny.exe"
      VALUE "ProductName", TINY_PRODUCT_NAME
      VALUE "ProductVersion", TINY_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
